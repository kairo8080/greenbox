.vercel
.env*
!.env.example

# Local deployment metadata and credentials.
.vercel/

# Godot caches are regenerated; keep .import settings and .uid sidecars.
.godot/
game/runtime/

# Browser exports in public/ are intentionally committed.
node_modules/
npm-debug.log*
*.tmp
*.blend1
*.blend2
.DS_Store
Thumbs.db
Desktop.ini

# Local generated previews and staging helpers.
outputs/
work/
__pycache__/
*.pyc

# Unity generated files. Keep Assets, Packages, ProjectSettings and .meta files.
unity/**/Library/
unity/**/Temp/
unity/**/Obj/
unity/**/Logs/
unity/**/UserSettings/
unity/**/Builds/
unity/**/MemoryCaptures/
unity/**/.vs/
unity/**/*.csproj
unity/**/*.sln
unity/tests/bin/
unity/tests/*.exe
unity/tests/*.pdb
unity-build/
